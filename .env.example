# Copie este arquivo para .env e ajuste conforme sua instalação.
# LOCAL = usa FFmpeg dentro do projeto; PATH = usa FFmpeg disponível no PATH.
FFMPEG_MODE=LOCAL
FFMPEG_LOCAL_PATH=bin/ffmpeg.exe

# Caminho do Tesseract (absoluto ou relativo à raiz do projeto).
TESSERACT_CMD=bin/Tesseract-OCR/tesseract.exe
